{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana": {
      "type": "local",
      "command": ["uvx", "mcp-grafana"],
      "enabled": true,
      "environment": {
        "GRAFANA_URL": "http://localhost:3001",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{file:./.secrets/grafana-token}"
      }
    }
  }
}
