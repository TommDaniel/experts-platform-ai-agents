# Copy to `.env` and adjust values.
# Local development only — never commit `.env`.

# API (apps/api)
API_PORT=3000

# App (apps/app)
APP_PORT=5173

# Database (Drizzle ORM, apps/api)
# Local Postgres via docker-compose.yml (service `postgres`, port 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Email (apps/api, EmailService)
# Base URL used to build links inside auth emails (the React app).
APP_URL=http://localhost:5173
# Transport is derived from NODE_ENV: production → Resend; otherwise → Mailtrap.
# NODE_ENV is optional and defaults to development when unset.

# Mailtrap (non-prod SMTP inbox — used when NODE_ENV != production)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=your-mailtrap-user
MAILTRAP_PASS=your-mailtrap-password
MAILTRAP_FROM=no-reply@example.com

# Resend (prod — used when NODE_ENV=production)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Acme <onboarding@resend.dev>

# Observability (OTLP → Grafana LGTM stack via docker-compose.yml)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=api
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:9009/otlp/v1/metrics
OTEL_LOGS_ENDPOINT=http://localhost:3100/otlp/v1/logs

# Grafana MCP (opencode.json reads `.secrets/grafana-token` via {file:...}).
# No env var needed: create a service account token in Grafana → Administration →
# Service accounts, save it in `.secrets/grafana-token` (gitignored) and never commit it.
# See `.docs/OBSERVABILITY.md` for the full setup.

# Grafana admin password for the local stack (defaults to `admin` when unset).
GRAFANA_ADMIN_PASSWORD=change-me

# Agents (docker-compose.yml loads `.env.local` via env_file)
# The container needs a real provider key for chat: OPENAI_API_KEY or GEMINI_API_KEY.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Experts / AI (013-experts)
# External API exceptions (all runtime infra is local via Docker).
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# LangSmith (cloud observability/evals) + LangGraph Server (local via Docker, port 2024)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=experts-local
AGENTS_URL=http://localhost:2024

# Weaviate (vector store, local via Docker, port 8080)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080

# Uploads (source files + generated media), served by the API at /api/v1/uploads/*
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
