{
  "name": "coders-university-module-4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt --write .",
    "code:fix": "oxlint --fix . && oxfmt --write .",
    "types:check": "turbo run types:check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "turbo run db:migrate",
    "prepare": "lefthook install",
    "env:setup": "cp .env.example .env.local",
    "local:setup": "bun i && bun env:setup && bun infra:up && bun db:migrate",
    "load:seed": "bun apps/api/scripts/load-seed.mjs",
    "load:clean": "bun apps/api/scripts/load-clean.mjs",
    "load:smoke": "docker run --rm -i -e API_URL -v \"$(pwd)/load:/load\" grafana/k6:2.2.0 run /load/smoke.js",
    "load:test": "docker run --rm -i -e API_URL -e LOAD_VUS -e LOAD_SIGNUP_VUS -e LOAD_RAMP_UP -e LOAD_HOLD -e LOAD_RAMP_DOWN -e LOAD_SLEEP_MS -e LOAD_P95_MS -e RUN_ID -e SEED_EMAIL -e LOAD_SEED_PASSWORD -e SIGNUP_PASSWORD -e LOAD_HELLO_EMAIL -e LOAD_ME_EMAIL -e LOAD_LOGOUT_EMAIL -v \"$(pwd)/load:/load\" grafana/k6:2.2.0 run /load/load.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,css,html,md}": [
      "oxfmt --write"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
